{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "soporte.plofarma.cl"
        }
      ],
      "destination": "/apps/Portalwhatsapp/inbox.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "soporte.plofarma.cl"
        }
      ],
      "destination": "/apps/Portalwhatsapp/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.plofarma.cl"
        }
      ],
      "destination": "/apps/Portal-PLO/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "soporte.plofarma.cl"
        }
      ],
      "destination": "/inbox.html",
      "permanent": false
    }
  ]
}
